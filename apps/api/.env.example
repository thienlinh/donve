# Bun/VPS entrypoint (bun.ts). CF Workers uses wrangler vars/secrets instead (wrangler.jsonc).
# Full reference list — matches `Bindings` in src/types.ts key for key. Copy to `.env.local`
# (gitignored, Bun auto-loads it) and fill in real values for local dev.
#
# NOTE: staging/production don't have an equivalent file — their secrets are set directly on
# Cloudflare with `wrangler secret put <KEY> --env <env>` (DATABASE_URL, BETTER_AUTH_SECRET,
# UPSTASH_*, RESEND_API_KEY, AI_KEY_MASTER_SECRET, PAYMENTS_KEY_MASTER_SECRET,
# TURNSTILE_SECRET_KEY, PLATFORM_OPENROUTER_API_KEY, CF_API_TOKEN, CF_ZONE_ID,
# UNSPLASH_ACCESS_KEY, PEXELS_API_KEY), while the rest (RUNTIME, TURNSTILE_SITE_KEY,
# PUBLISH_BASE_DOMAIN, CF_CUSTOM_DOMAIN_TARGET, FOUNDER_ALERT_EMAIL, LOCAL_STORAGE_DIR,
# LOCAL_DEPLOYMENTS_DIR, LOCAL_REDIS_URL) are non-secret and live in apps/api/wrangler.jsonc `vars` per `env`
# block instead. This file needs the full list because Bun local dev has no wrangler.jsonc to
# fall back to. See docs/runbooks/setup-deployment.md for the full table.

PORT=3000
RUNTIME=bun
# Local dev: docker compose up -d, rồi dùng giá trị dưới (khớp docker-compose.yml)
# DATABASE_URL=postgres://donve:donve@localhost:5432/donve
DATABASE_URL=
# Chỉ dùng khi RUNTIME=workers (staging/prod thật trên Cloudflare qua wrangler secret). Ở
# RUNTIME=bun (dev/VPS) để trống — cache/realtime tự rơi về LOCAL_REDIS_URL, không cần điền.
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Bun/VPS plain-Redis standing for UPSTASH_* (rate limit, hostname KV, realtime pub/sub) —
# docker compose up -d rồi để trống là dùng đúng giá trị khớp docker-compose.yml, chỉ cần
# đổi nếu Redis chạy ở nơi khác.
# LOCAL_REDIS_URL=redis://localhost:6379
LOCAL_REDIS_URL=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:5173

# Resend API key for the mail.donve.vn sender (FR-I-05/06) — verify SPF/DKIM/DMARC
# on that domain in Resend before sending real email with this key.
RESEND_API_KEY=

# 32-byte AES-256-GCM master key (base64url) that wraps every BYOK connection's API key
# (packages/ai-gateway/src/key-vault.ts). Without this, POST /api/ai/connections crashes
# with a generic 500 "internal_error" the instant it tries to encrypt the key for storage.
# Generate locally with `crypto.getRandomValues` — dev-only value, never reuse staging/prod's.
AI_KEY_MASTER_SECRET=

# Same key-vault format, separate master key for `paymentConnections.encryptedApiKey`
# (business-analysis.md §4.4). Without this, POST /api/payments/connections crashes the
# same way as AI_KEY_MASTER_SECRET above.
PAYMENTS_KEY_MASTER_SECRET=

# Cloudflare Turnstile (FR-D-03). Secret key verifies server-side; the well-known
# "always passes" test keys below are safe dev defaults — replace with real ones in
# staging/production (see docs/runbooks/setup-deployment.md).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Platform's own OpenRouter key for the no-BYOK trial / platform-paid usage (FR-H-02).
PLATFORM_OPENROUTER_API_KEY=

# Commercial-license stock photo sources for FR-B-32/33 — optional, feature degrades to
# "no stock suggestions" (tenant/placeholder images only) when unset.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Published-landing domain suffix — `${subdomain}.${PUBLISH_BASE_DOMAIN}`.
PUBLISH_BASE_DOMAIN=donve.vn

# Bun/VPS local-fs standing for CF's R2 bindings (LANDING_ASSETS_BUCKET/DEPLOYMENTS_BUCKET) —
# only used under RUNTIME=bun; defaults to `.data/storage` / `.data/deployments` if unset.
LOCAL_STORAGE_DIR=
LOCAL_DEPLOYMENTS_DIR=

# FR-G-04 custom domains (Cloudflare for SaaS) — optional, custom-domain routes 501 without
# these. CF_CUSTOM_DOMAIN_TARGET is not a secret (public CNAME target) but listed here to
# keep every Bindings key in one file.
CF_API_TOKEN=
CF_ZONE_ID=
CF_CUSTOM_DOMAIN_TARGET=cname.donve.vn

# NFR-14 traffic-spike alert recipient — optional, feature no-ops without it.
FOUNDER_ALERT_EMAIL=

# Facebook App secret verifying X-Hub-Signature-256 on POST /webhooks/facebook-leads — fallback
# used only for orgs that haven't configured their own webhook credentials (see
# WEBHOOK_KEY_MASTER_SECRET below); the webhook 401s on every call if neither is set.
FACEBOOK_APP_SECRET=
# Zalo OA webhook signing secret for POST /webhooks/zalo-oa — same role as FACEBOOK_APP_SECRET.
ZALO_OA_SECRET=

# Donve's own TikTok for Business Marketing API developer app (lead-integrations.md §D) — ONE
# shared app for the whole platform (unlike FACEBOOK_APP_SECRET/ZALO_OA_SECRET, there is no
# per-org override for TikTok; an individual advertiser never creates their own TikTok Developer
# App). Used both to exchange an OAuth auth_code for an advertiser's access_token
# (GET /webhooks/tiktok-oauth-callback) and to verify the Tiktok-Signature header on
# POST /webhooks/tiktok-leads. Create the app at business-api.tiktok.com/portal, add the
# Marketing API product, enable Lead Generation/Instant Form permissions, and add this API's
# /webhooks/tiktok-oauth-callback URL as one of the app's advertiser redirect URLs.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# The "Advertiser authorization URL" shown in the TikTok App console (My Apps > App Detail >
# Basic Information) — copy it as-is, TikTok generates it once the redirect URL above is
# configured. Not a URL Donve constructs from a template.
TIKTOK_ADVERTISER_AUTH_URL=

# Same key-vault format as AI_KEY_MASTER_SECRET/PAYMENTS_KEY_MASTER_SECRET above, separate
# master key wrapping `webhookCredentials.encryptedSecret` — an org's own Facebook App/Zalo OA
# secret, so one org can't forge leads into another org's account by reusing the shared
# FACEBOOK_APP_SECRET/ZALO_OA_SECRET above (lead-integrations.md §4). Without this,
# PUT /api/leads/webhook-credentials/:provider crashes the same way AI_KEY_MASTER_SECRET's
# absence crashes POST /api/ai/connections.
WEBHOOK_KEY_MASTER_SECRET=

# Same key-vault format, wrapping `notifyCredentials.encryptedSecret` — an org's own Zalo ZNS
# access token / eSMS API key for the notify_manager push channel (packages/drivers/src/notify).
# Optional: unlike the other master secrets, this feature is fully opt-in (default channel is
# email, no BYOK needed) — PUT /api/leads/notify-credentials/:provider 501s with
# notify_key_master_secret_unconfigured when this is unset, rather than crashing.
NOTIFY_KEY_MASTER_SECRET=
