VITE_API_URL=http://localhost:3000
# Donve's shared TikTok App's own "Advertiser authorization URL" (copied as-is from
# business-api.tiktok.com/portal > My Apps > App Detail > Basic Information — see
# apps/api/.env.example's TIKTOK_ADVERTISER_AUTH_URL doc comment). Public by design — it's the
# link an advertiser clicks to approve access, not a secret. The Settings UI appends
# `&state=<orgId>:<campaignId>` before showing the "Connect TikTok Ads" button.
VITE_TIKTOK_ADVERTISER_AUTH_URL=
